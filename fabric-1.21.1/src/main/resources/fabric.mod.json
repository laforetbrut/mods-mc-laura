{
  "schemaVersion": 1,
  "id": "${mod_id}",
  "version": "${mod_version}",
  "name": "${mod_name}",
  "description": "${mod_description}",
  "authors": [
    "${mod_authors}"
  ],
  "contact": {
    "homepage": "https://github.com/laforetbrut/lauramod",
    "sources": "https://github.com/laforetbrut/lauramod",
    "issues": "https://github.com/laforetbrut/lauramod/issues"
  },
  "license": "${mod_license}",
  "icon": "lauramod_logo.png",
  "environment": "*",
  "entrypoints": {
    "main": [
      "com.vyrriox.lauramod.fabric.LauraFabric"
    ],
    "client": [
      "com.vyrriox.lauramod.fabric.LauraFabricClient"
    ]
  },
  "depends": {
    "fabricloader": ">=0.15.11",
    "fabric-api": "*",
    "minecraft": "${minecraft_version_range}",
    "java": ">=21"
  }
}
